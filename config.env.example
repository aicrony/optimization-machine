# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Anthropic API (Claude)
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Claude Model Tiers (optional - defaults are sensible)
# Available models: claude-haiku-4-5-20251212, claude-sonnet-4-5-20250929, claude-opus-4-5-20251101
# CLAUDE_MODEL_HAIKU=claude-haiku-4-5-20251212
# CLAUDE_MODEL_SONNET=claude-sonnet-4-5-20250929
# CLAUDE_MODEL_OPUS=claude-opus-4-5-20251101
#
# Task-to-model mapping (which tier to use for each task)
# Options: haiku, sonnet, opus
# CLAUDE_TIER_STRATEGY_GENERATION=sonnet
# CLAUDE_TIER_STRATEGY_REFINEMENT=sonnet
# CLAUDE_TIER_CODE_GENERATION=sonnet
# CLAUDE_TIER_EVALUATION=haiku
# CLAUDE_TIER_TREND_ANALYSIS=haiku

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Stripe API
STRIPE_API_KEY=sk_test_your-stripe-key

# Google Analytics 4 Configuration
# Create a service account in Google Cloud Console with Analytics Viewer role
# Download the JSON key file and set the path below
GA4_CREDENTIALS_PATH=./credentials/ga4-service-account.json
# Get your GA4 Property ID from Admin > Property Details (format: properties/XXXXXXXXX)
GA4_PROPERTY_ID=properties/123456789

# Chrome UX Report (CrUX) API
# Enable Chrome UX Report API in Google Cloud Console and create an API key
CRUX_API_KEY=your-google-cloud-api-key
# Your app's origin URL for CrUX queries (must have sufficient traffic for data)
GENTUBE_ORIGIN=https://gentube.ai

# Vercel Deployment
VERCEL_TOKEN=your-vercel-token
VERCEL_PROJECT_ID=your-project-id
VERCEL_PROJECT_NAME=gentube

# Google Cloud Datastore (UserActivity)
GCD_TYPE=service_account
GCD_PROJECT_ID=your-gcp-project-id
GCD_PRIVATE_KEY_ID=your-private-key-id
GCD_PRIVATE_KEY=your-private-key
GCD_CLIENT_EMAIL=your-client-email
GCD_CLIENT_ID=your-client-id
GCD_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GCD_TOKEN_URI=https://oauth2.googleapis.com/token
GCD_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GCD_CLIENT_X509_CERT_URL=your-cert-url
GCD_NAMESPACE=GenTube
# Comma-separated user IDs to exclude from activity analysis (test accounts)
GCD_EXCLUDED_USER_IDS=

# Supabase Auth Database (separate instance with auth.users table)
SUPABASE_AUTH_URL=https://your-auth-project.supabase.co
SUPABASE_AUTH_KEY=your-supabase-auth-service-role-key

# Gentube App Configuration
GENTUBE_APP_URL=https://your-app.vercel.app
GENTUBE_API_ENDPOINT=https://your-app.vercel.app/api
GENTUBE_APP_PATH=../gentube-ai-multi
GITHUB_REPO=username/gentube-ai-multi
# SSH key for agent git operations (allows agent to use dedicated deploy key
# while developer uses personal key on same repo)
GIT_SSH_KEY_PATH=~/.ssh/gentube_deploy

# Monitoring & Alerts
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890
ALERT_PHONE_NUMBER=+1234567890

# System Configuration
CYCLE_INTERVAL_HOURS=12
APPROVAL_TIMEOUT_HOURS=24
LOG_LEVEL=INFO
ENVIRONMENT=development

# Safety Net Configuration
MAX_METRIC_DROP_PERCENT=20
MIN_APPROVAL_WAIT_MINUTES=5
ROLLBACK_ENABLED=true

# Local Model Configuration (optional fallback)
USE_LOCAL_MODEL=false
LOCAL_MODEL_PATH=./models/llama
